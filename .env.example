# ========================================================
# AI File Manager - Environment Configuration
# ========================================================

# Default AI Provider: "offline", "gemini", or "openai"
# - "offline": Zero setup, uses local content intelligence heuristic engine
# - "gemini": Google Gemini 2.5 Flash (requires GEMINI_API_KEY)
# - "openai": OpenAI GPT-4o-mini (requires OPENAI_API_KEY)
DEFAULT_AI_PROVIDER=gemini

# Google Gemini API Key
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key
# Obtain from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Generic Fallback API Key (optional)
AI_API_KEY=

# Duplicate Detection Settings
# Maximum perceptual hash distance to consider two images "similar" (default: 4)
MAX_PHASH_DISTANCE=4
